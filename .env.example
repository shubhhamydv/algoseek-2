# Web application
VITE_APP_TITLE=AlgoSeek
PORT=3000

# Set both to use the real FastAPI/Qdrant path. The lecture preview still works
# without these values.
LIVE_AI_ENABLED=false
AI_SERVICE_URL=http://127.0.0.1:8000

# Qdrant. Leave QDRANT_URL empty for the Python service's local embedded store.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
YTRAG_QDRANT_PATH=
YTRAG_COLLECTION=dsa_lectures
YTRAG_UPLOAD_COLLECTION=user_uploads

# Embeddings and ingestion. Do not change the lecture model without a deliberate
# reindex; uploads receive a separate dimension-suffixed collection.
YTRAG_EMBED_MODEL=all-MiniLM-L6-v2
YTRAG_EMBED_BATCH=16
YTRAG_UPSERT_BATCH=128
YTRAG_UPLOAD_UPSERT_BATCH=128
YTRAG_UPLOAD_TEXT_MAX_DISTANCE=0.65
YTRAG_UPLOAD_PDF_MAX_DISTANCE=0.65

# Optional grounded answer providers. Do not put secrets in source control.
YTRAG_LLM_BACKEND=none
GEMINI_API_KEY=
GROQ_API_KEY=
YTRAG_LLM_MODEL=
