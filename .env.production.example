# ==============================================================================
# ALGOSEEK PRODUCTION ENVIRONMENT CONFIGURATION (PAAS / CLOUD)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WEB APP & NODE API GATEWAY (Railway / Render Service: algoseek-web)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
VITE_APP_TITLE=AlgoSeek

# Toggle live AI backend (set to true to use the FastAPI Python backend)
LIVE_AI_ENABLED=true

# URL pointing to your deployed Python AI service:
# - On Railway (internal private network): http://algoseek-ai.railway.internal:8000
# - On Render / Public PaaS: https://your-algoseek-ai.onrender.com
AI_SERVICE_URL=http://algoseek-ai.railway.internal:8000

# Optional: MySQL database connection for user authentication and session history
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Leave empty if you are running in guest / credential-free preview mode
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. VECTOR DATABASE (QDRANT CLOUD - Free 1GB Cluster)
# Required by BOTH algoseek-web and algoseek-ai services
# ------------------------------------------------------------------------------
# Get your cluster URL and API key from https://cloud.qdrant.io
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east-4-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# Collection names in Qdrant
YTRAG_COLLECTION=dsa_lectures
YTRAG_UPLOAD_COLLECTION=user_uploads

# ------------------------------------------------------------------------------
# 3. AI & RAG SERVICE (Railway / Render Service: algoseek-ai)
# ------------------------------------------------------------------------------
# Embedding model (all-MiniLM-L6-v2 has 384 dimensions and is pre-cached in the Docker image)
YTRAG_EMBED_MODEL=all-MiniLM-L6-v2
YTRAG_EMBED_BATCH=16
YTRAG_UPSERT_BATCH=128
YTRAG_UPLOAD_UPSERT_BATCH=128
YTRAG_UPLOAD_TEXT_MAX_DISTANCE=0.65
YTRAG_UPLOAD_PDF_MAX_DISTANCE=0.65

# Answer Provider Backend: "groq", "gemini", or "none" (extractive fallback)
YTRAG_LLM_BACKEND=groq

# Fast LLM API Keys (Get free keys at https://console.groq.com or https://aistudio.google.com)
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...
YTRAG_LLM_MODEL=llama-3.3-70b-versatile
